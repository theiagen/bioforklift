# OAuth Configuration (Required for production)
GOOGLE_CLIENT_ID=your-google-oauth-client-id
GOOGLE_CLIENT_SECRET=your-google-oauth-client-secret
SECRET_KEY=your-super-secret-session-key

# GCP Project Configuration (Required)
TARGET_PROJECT_ID=your-target-gcp-project
DATASET_ID=your-bigquery-dataset

# BigQuery Configuration (Optional - defaults provided)
BIGQUERY_PROJECT_ID=your-bigquery-project-id
BIGQUERY_DATASET_ID=your-bigquery-dataset-id
BIGQUERY_SAMPLES_TABLE=samples
BIGQUERY_CONFIGS_TABLE=configs

# Application Configuration (Optional)
ENVIRONMENT=production
FRONTEND_URL=http://localhost:5173

# Development Configuration (Optional)
# Set ENVIRONMENT=development to bypass OAuth validation for testing